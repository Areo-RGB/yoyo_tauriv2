{
  "name": "yoyo-tauri-android",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "svelte-check --tsconfig ./tsconfig.app.json && vite build",
    "check": "svelte-check --tsconfig ./tsconfig.app.json",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "tauri": "tauri",
    "android:init": "tauri android init && node scripts/patch-android-manifest.mjs",
    "android:dev": "node scripts/patch-android-manifest.mjs && tauri android dev",
    "android:build": "node scripts/patch-android-manifest.mjs && tauri android build",
    "android:install": "scripts/install-device.sh"
  },
  "dependencies": {
    "@tauri-apps/api": "2.11.1",
    "@tauri-apps/plugin-store": "2.4.4",
    "carbon-components-svelte": "^0.111.1",
    "carbon-icons-svelte": "^13.15.0",
    "svelte": "^5.38.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^6.2.0",
    "@tauri-apps/cli": "2.11.4",
    "carbon-preprocess-svelte": "^0.11.43",
    "svelte-check": "^4.3.1",
    "typescript": "^5.9.2",
    "vite": "^7.1.4"
  }
}
